# Dependencies (every package: root, admin, infra)
node_modules/

# Build output, regenerated by `npm run build` and `cdk synth`
dist/
.astro/
cdk.out/
cdk.out.*/
infra/build/
csp-hashes.json
*.tsbuildinfo

# Secrets and credentials: never commit any of these
.env
.env.*
!.env.example
.aws/
*.pem
*.key
*.p12
credentials
credentials.*

# Migrated media is served from the media bucket; keep it out of the repository (samples stay).
public/media/*
!public/media/samples/
# Phase 8 migration staging (originals, variants, report)
/migration/

# Local tooling and editors
.claude/
.vscode/
.idea/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Logs, caches and test output
*.log
npm-debug.log*
.cache/
.eslintcache
coverage/
*.tmp
