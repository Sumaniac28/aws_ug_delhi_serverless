---
import CountUp from './CountUp.astro';

// Big real numbers with small labels. Only ever fed from content, never invented. Counts up once on scroll-in.
interface Props {
  items: { value: number; label: string; suffix?: string }[];
  tone?: 'paper' | 'ink';
}
const { items, tone = 'paper' } = Astro.props;
---

<dl class:list={['grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4', tone === 'ink' ? 'text-ink-foreground' : 'text-foreground']} data-reveal="stagger">
  {
    items.map((i) => (
      <div class="border-l-[3px] border-line pl-5">
        <dd class="font-display text-stat font-bold"><CountUp value={i.value} suffix={i.suffix} /></dd>
        <dt class:list={['eyebrow mt-3 !text-[0.8125rem]', tone === 'ink' ? '!text-ink-muted' : '!text-muted-foreground']}>{i.label}</dt>
      </div>
    ))
  }
</dl>
