---
import Icon from './Icon.astro';

// A small label: icon plus text, never colour alone (WCAG 1.4.1). For series, mode, place and counts.
interface Props {
  icon?: string;
  tone?: 'neutral' | 'ink' | 'line';
  class?: string;
}
const { icon, tone = 'neutral', class: className } = Astro.props;
const tones = {
  neutral: 'border-border bg-muted text-foreground',
  ink: 'border-transparent bg-ink text-ink-foreground',
  line: 'border-transparent bg-primary text-primary-foreground',
};
---

<span class:list={['inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-sm font-bold leading-6', tones[tone], className]}>
  {icon && <Icon name={icon} size={15} />}<slot />
</span>
