---
import AvatarStack from './AvatarStack.astro';
import Icon from './Icon.astro';
import Media from './Media.astro';
import Pill from './Pill.astro';
import StatusBadge from './StatusBadge.astro';
import { coverOf } from '../lib/content';
import type { EventView, SpeakerView } from '../lib/content';
import { placeOf, SERIES_LABEL } from '../lib/cta';
import { dayOf, monthOf, yearOf } from '../lib/time';

// An image-led event card: cover photo, ticket-style date, series and place, the title as the one link, and the
// faces of who spoke. `feature` lays it out as a wide card for the next or latest event.
interface Props {
  event: EventView;
  speakers?: Map<string, SpeakerView>;
  feature?: boolean;
  /** Mark the card as the interchange: the next stop. */
  next?: boolean;
  eager?: boolean;
}
const { event, speakers, feature = false, next = false, eager = false } = Astro.props;
const { data } = event;
const cover = coverOf(event);
const faces = speakers ? data.speakers.map((id) => speakers.get(id)).filter((s): s is SpeakerView => !!s).map((s) => ({ name: s.data.name, photo: s.published ? s.data.photo : undefined })) : [];
const count = data.speakers.length;
---

<article class:list={['card card-hover card-lift group relative flex overflow-hidden', feature ? 'flex-col md:flex-row' : 'flex-col', next && 'border-line']} data-vt-group data-end={data.end}>
  <div class:list={['relative overflow-hidden bg-muted', feature ? 'aspect-[3/2] md:aspect-auto md:w-1/2' : 'aspect-[3/2]']}>
    {
      cover ? (
        <Media mediaKey={cover} alt="" width={960} height={640} sizes={feature ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 1024px) 360px, (min-width: 640px) 45vw, 100vw'} eager={eager} vt="source" class="size-full object-cover" />
      ) : (
        <svg viewBox="0 0 300 200" class="size-full" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
          <rect width="300" height="200" class="fill-muted"></rect>
          <line x1="0" y1="110" x2="300" y2="110" class="stroke-line" stroke-width="8"></line>
          <circle cx="90" cy="110" r="12" class="fill-background stroke-foreground" stroke-width="5"></circle>
          <circle cx="210" cy="110" r="18" class="fill-background stroke-foreground" stroke-width="6"></circle>
        </svg>
      )
    }
    <div class="absolute left-3 top-3 flex flex-col items-center rounded-md border border-border bg-card px-2.5 py-1.5 text-card-foreground leading-none" aria-hidden="true">
      <span class="font-mono text-xs font-bold tracking-wide">{monthOf(data.start)}</span>
      <span class="mt-0.5 font-display text-2xl font-bold [font-stretch:82%]">{dayOf(data.start)}</span>
      <span class="mt-0.5 font-mono text-[0.6875rem] text-muted-foreground">{yearOf(data.start)}</span>
    </div>
    {event.phase !== 'past' && <div class="absolute right-3 top-3"><StatusBadge event={event} /></div>}
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex flex-wrap items-center gap-2">
      <Pill>{SERIES_LABEL[data.series]}</Pill>
      <Pill icon="map-pin">{placeOf(event)}</Pill>
    </div>
    <h3 class:list={['font-display', feature ? 'text-3xl md:text-4xl' : 'text-2xl']}>
      <a href={event.url} class="no-underline after:absolute after:inset-0 hover:underline focus-visible:underline" data-vt-link data-vt-title>{data.title}</a>
    </h3>
    <p class:list={['text-muted-foreground', feature ? 'line-clamp-4' : 'line-clamp-2']}>{data.summary}</p>
    <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-2">
      <AvatarStack people={faces} />
      <span class="inline-flex items-center gap-1.5 text-sm font-bold text-primary-accent">
        {count > 0 ? `${count} ${count === 1 ? 'speaker' : 'speakers'}` : 'Event details'}
        <Icon name="arrow-right" size={16} />
      </span>
    </div>
  </div>
</article>
