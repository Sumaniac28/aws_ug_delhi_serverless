---
// The top of every list and landing page: breadcrumb, title, lede, an optional meta row and actions.
// One component so every page opens the same way (DESIGN.md, "Components").
interface Props {
  title: string;
  lede?: string;
  crumbs?: { label: string; href?: string }[];
  /** Narrow reading width (blog, contact). */
  narrow?: boolean;
}
const { title, lede, crumbs = [], narrow = false } = Astro.props;
---

<header class:list={[narrow ? 'wrap-narrow' : 'wrap', 'pt-12 pb-8 md:pt-16']}>
  {
    crumbs.length > 0 && (
      <nav class="mb-5 text-[0.9375rem] text-muted-foreground" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-x-2">
          {crumbs.map((c, i) => (
            <li class="flex items-center gap-2">
              {i > 0 && <span aria-hidden="true">/</span>}
              {c.href ? <a class="hover:underline" href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )
  }
  <h1 class="text-6xl md:text-7xl">{title}</h1>
  <span class="hero-rule mt-5 block h-1.5 w-20 rounded-full bg-line" aria-hidden="true"></span>
  {lede && <p class="mt-5 max-w-2xl text-xl text-muted-foreground">{lede}</p>}
  <div class="mt-6 empty:hidden"><slot /></div>
</header>
