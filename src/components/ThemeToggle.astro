---
// Two-state toggle. Light is the default; "dark" is stored only when chosen, and removed when
// the visitor switches back. Hidden until JS has run (html[data-js]), so there is no dead button.
---

<button
  type="button"
  class="theme-toggle hidden size-11 place-items-center rounded-md border border-input text-foreground hover:bg-muted [html[data-js]_&]:grid"
  aria-pressed="false"
>
  <svg class="dark:hidden" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="hidden dark:block" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
  <span class="visually-hidden">Dark theme</span>
</button>

<script>
  const KEY = 'theme';
  const root = document.documentElement;
  const meta = document.querySelector('meta[name="theme-color"]');

  const isDark = () => root.classList.contains('dark');
  const sync = () => {
    document.querySelectorAll('.theme-toggle').forEach((b) => b.setAttribute('aria-pressed', String(isDark())));
    meta?.setAttribute('content', isDark() ? '#0d1b2f' : '#fbfaf7');
  };
  const read = () => {
    try {
      return localStorage.getItem(KEY) === 'dark';
    } catch {
      return false;
    }
  };
  const apply = (dark: boolean) => {
    root.classList.toggle('dark', dark);
    sync();
  };

  document.querySelectorAll('.theme-toggle').forEach((b) =>
    b.addEventListener('click', () => {
      const dark = !isDark();
      try {
        if (dark) localStorage.setItem(KEY, 'dark');
        else localStorage.removeItem(KEY);
      } catch {}
      // A short cross-fade between themes where the browser supports it (motion.css times it); otherwise a plain switch.
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (document.startViewTransition && !reduced) document.startViewTransition(() => apply(dark));
      else apply(dark);
    }),
  );

  // Other tabs, and pages restored from the back/forward cache.
  addEventListener('storage', (e) => {
    if (e.key === KEY || e.key === null) apply(read());
  });
  addEventListener('pageshow', (e) => {
    if (e.persisted) apply(read());
  });
  sync();
</script>
