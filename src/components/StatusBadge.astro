---
import Pill from './Pill.astro';
import type { EventView } from '../lib/content';

interface Props {
  event: EventView;
}

const { event } = Astro.props;
const { status } = event.data;

// Cancelled/postponed/rescheduled override the time-based phase.
const kind = status !== 'scheduled' ? status : event.phase;
const labels: Record<string, string> = {
  upcoming: 'Upcoming',
  today: 'Today',
  past: 'Past',
  cancelled: 'Cancelled',
  postponed: 'Postponed',
  rescheduled: 'Rescheduled',
};
const tone = { upcoming: 'success', today: 'line', past: 'neutral', cancelled: 'danger', postponed: 'warning', rescheduled: 'warning' } as const;
---

<Pill data-status={kind} tone={tone[kind as keyof typeof tone]}>{labels[kind]}</Pill>
