---
// Pause control for anything that moves or updates on its own (WCAG 2.2.2). A toggle with a fixed name and
// aria-pressed; it pauses the nearest [data-pausable] ancestor (src/scripts/motion.ts). Hidden until JS runs.
interface Props {
  /** What it pauses, for screen readers: "Pause partner logos". */
  label: string;
  /** "ink" on the dark countdown board. */
  tone?: 'paper' | 'ink';
}
const { label, tone = 'paper' } = Astro.props;
---

<button type="button" class:list={['pause-btn', tone === 'ink' && 'pause-btn--ink']} aria-pressed="false" data-pause aria-label={label}>
  <svg class="icon-pause" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
  <svg class="icon-play" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"></path></svg>
  <span aria-hidden="true">Pause</span>
</button>
