---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import PageHeader from '../components/PageHeader.astro';
import PersonCard from '../components/PersonCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StatStrip from '../components/StatStrip.astro';
import { coverOf, getOrganizers, getPastEvents, getSpeakers, site } from '../lib/content';
import { formatDateLong } from '../lib/time';

// About is a Markdown story (src/content/pages/about.md) wrapped in an editorial layout.
const page = (await getEntry('pages', 'about'))!;
const { Content } = await render(page);
const [past, organizers, speakers] = await Promise.all([getPastEvents(), getOrganizers(), getSpeakers()]);

const photoEvent = past.find((e) => e.data.series === 'community-day' && coverOf(e)) ?? past.find((e) => coverOf(e));

// "Recent stops": the latest events on the line. No "first" or "biggest" claims, and no start year: the group is
// older than the records on this site, so anything that sounds like a total or a beginning would mislead.
const recent = past.slice(0, 4);

const attendees = past.reduce((n, e) => n + (e.data.stats?.attendees ?? 0), 0);
const stats = [
  { value: past.length, label: 'events listed here' },
  { value: speakers.size, label: 'speakers' },
  ...(attendees > 0 ? [{ value: attendees, suffix: '+', label: 'attendees across them' }] : []),
];

const team = [...organizers].sort((a, b) => Number(/lead/i.test(b.data.role)) - Number(/lead/i.test(a.data.role)) || a.data.name.localeCompare(b.data.name));

const values = [
  { icon: 'heart-handshake', title: 'Open to everyone', text: 'Beginners and experts, students and professionals. Questions are always welcome.' },
  { icon: 'users', title: 'Run by volunteers', text: 'Everyone on the team does this in their spare time, because they enjoy it.' },
  { icon: 'presentation', title: 'Learning in the open', text: 'Talks, workshops and recaps shared openly, so the learning outlasts the day.' },
];
const steps = [
  { title: 'Come to an event', text: 'Meetups are free and friendly. Pick one and turn up.', href: '/events/', label: 'See events' },
  { title: 'Share what you know', text: 'First-time speakers are very welcome. We will help you shape the talk.', href: `mailto:${site.contactEmail}?subject=Speaking%20at%20AWS%20UG%20Delhi%20NCR`, label: 'Propose a talk' },
  { title: 'Help run the day', text: 'Volunteers check people in, welcome speakers and keep the day moving.', href: `mailto:${site.contactEmail}?subject=Volunteering`, label: 'Volunteer' },
  { title: 'Back an event', text: 'Venues and food make a meetup work. Your team can help keep it free.', href: '/sponsors/', label: 'Become a partner' },
];
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <PageHeader title="About us" lede="A community of builders learning AWS together in Delhi, Gurugram and Noida." crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]} />

  <section class="wrap grid gap-10 pb-16 lg:grid-cols-12 lg:items-start" aria-label="Our story">
    <div class="prose-md prose-lead lg:col-span-7"><Content /></div>
    {
      photoEvent && (
        <figure class="lg:col-span-5">
          <div class="relative isolate">
            <span class="absolute inset-0 -z-10 translate-x-3 translate-y-3 rounded-lg bg-ink" aria-hidden="true"></span>
            <Media mediaKey={coverOf(photoEvent)!} alt={`People at ${photoEvent.data.title}`} width={1200} height={900} sizes="(min-width: 1024px) 460px, 100vw" class="aspect-[4/3] w-full rounded-lg border border-border object-cover" />
          </div>
          <figcaption class="mt-5 text-sm text-muted-foreground">{photoEvent.data.title}, {formatDateLong(photoEvent.data.start)}</figcaption>
        </figure>
      )
    }
  </section>

  <section class="wrap border-t border-border py-16" aria-labelledby="values">
    <SectionHeader id="values" title="What we stand for" />
    <ul class="grid gap-4 md:grid-cols-3" data-reveal="stagger">
      {
        values.map((v) => (
          <li class="card flex flex-col gap-3 p-6">
            <span class="grid size-12 place-items-center rounded-md bg-primary text-primary-foreground"><Icon name={v.icon} size={26} /></span>
            <h3 class="font-display text-2xl">{v.title}</h3>
            <p class="text-muted-foreground">{v.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    past.length > 0 && (
      <section class="band-ink" aria-labelledby="line-so-far">
        <div class="wrap py-16">
          <SectionHeader id="line-so-far" title="Recent stops" tone="ink" href="/events/past/" linkLabel="All past events" />
          <StatStrip items={stats} tone="ink" />
          <ol class="metro metro--vertical mt-14 max-w-2xl text-ink-foreground" data-reveal="line">
            {recent.map((e) => (
              <li class="metro-item" data-state="upcoming">
                <span class="metro-dot" aria-hidden="true" />
                <p class="font-mono text-sm text-ink-muted">{formatDateLong(e.data.start)}</p>
                <h3 class="mt-1 text-2xl"><a class="text-ink-foreground after:absolute after:inset-0" href={e.url}>{e.data.title}</a></h3>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    team.length > 0 && (
      <section class="wrap py-16" aria-labelledby="team">
        <SectionHeader id="team" title="The organizing team" count={team.length} />
        <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5" data-reveal="stagger">
          {team.map((o) => <li><PersonCard name={o.data.name} photo={o.data.photo} line={o.data.role} linkedin={o.data.linkedin} /></li>)}
        </ul>
      </section>
    )
  }

  <section class="wrap border-t border-border py-16" aria-labelledby="involved">
    <SectionHeader id="involved" title="Get involved" />
    <ol class="grid gap-4 md:grid-cols-2 lg:grid-cols-4" data-reveal="stagger">
      {
        steps.map((s, i) => (
          <li class="card flex flex-col gap-3 p-6">
            <span class="font-display text-5xl font-bold text-primary-accent [font-stretch:82%]" aria-hidden="true">{i + 1}</span>
            <h3 class="font-display text-2xl">{s.title}</h3>
            <p class="text-muted-foreground">{s.text}</p>
            <a class="link mt-auto inline-flex min-h-11 items-center gap-1.5 font-bold" href={s.href}>{s.label}<Icon name="arrow-right" size={18} /></a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
