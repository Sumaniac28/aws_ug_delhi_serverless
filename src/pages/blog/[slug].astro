---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import Icon from '../../components/Icon.astro';
import Media from '../../components/Media.astro';
import { getEvents, getOrganizers, getPosts, getSpeakers, readingTime } from '../../lib/content';
import { blogPostingJsonLd, breadcrumbJsonLd } from '../../lib/jsonld';
import { absoluteMediaUrl } from '../../lib/media';
import { outline, renderMarkdown } from '../../lib/markdown';
import { formatDateLong, formatDateShort } from '../../lib/time';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }));
}

const { post, newer, older } = Astro.props;
const { data } = post;
const site = Astro.site!;
const [organizers, events, speakers, posts] = await Promise.all([getOrganizers(), getEvents(), getSpeakers(), getPosts()]);
const authorEntry = organizers.find((o) => o.id === data.author);
const author = authorEntry?.data.name ?? 'AWS UG Delhi NCR';
const related = data.relatedEvent ? events.find((e) => e.id === data.relatedEvent) : undefined;
const url = new URL(`/blog/${post.id}/`, site).href;
const minutes = readingTime(data.body);
const toc = outline(data.body);
const more = posts.filter((p) => p.id !== post.id).slice(0, 3);
const shareUrl = encodeURIComponent(url);
const shareText = encodeURIComponent(data.title);

const jsonLd = [
  blogPostingJsonLd(data, author, url, site, absoluteMediaUrl(data.heroImage, site)),
  breadcrumbJsonLd([
    { name: 'Home', url: new URL('/', site).href },
    { name: 'Blog', url: new URL('/blog/', site).href },
    { name: data.title, url },
  ]),
];
---

<BaseLayout title={data.title} description={data.description} type="article" image={absoluteMediaUrl(data.heroImage, site) ?? new URL(`/og/posts/${post.id}/og.png`, site).href} {jsonLd}>
  <article>
    <header class="wrap-narrow pt-12 pb-8">
      <nav class="text-meta text-muted-foreground" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-x-2"><li><a class="hover:underline" href="/blog/">Blog</a></li></ol>
      </nav>
      {data.tags.length > 0 && <p class="eyebrow mt-5">{data.tags.join(' · ')}</p>}
      <h1 class="mt-3">{data.title}</h1>
      <p class="mt-4 text-lede text-muted-foreground">{data.description}</p>
      <div class="mt-6 flex items-center gap-4 border-t border-border pt-5">
        <span class="grid size-12 shrink-0 place-items-center overflow-hidden rounded-full bg-secondary font-display font-bold text-secondary-foreground" aria-hidden="true">
          {authorEntry?.data.photo ? <Media mediaKey={authorEntry.data.photo} alt="" width={48} height={48} sizes="48px" class="size-full object-cover" /> : author[0]}
        </span>
        <p class="text-meta">
          <span class="block font-semibold">{author}{authorEntry?.data.role && <span class="font-normal text-muted-foreground"> · {authorEntry.data.role}</span>}</span>
          <span class="text-muted-foreground"><time datetime={data.pubDate}>{formatDateLong(data.pubDate)}</time> &middot; {minutes} min read{data.updatedDate && <> &middot; Updated <time datetime={data.updatedDate}>{formatDateLong(data.updatedDate)}</time></>}</span>
        </p>
      </div>
    </header>
    {data.heroImage && <div class="wrap"><Media mediaKey={data.heroImage} alt="" eager sizes="(min-width: 1152px) 1152px, 100vw" class="aspect-[16/9] w-full rounded-xl border border-border object-cover" /></div>}
    <div class:list={['py-10', toc.length >= 3 ? 'wrap grid gap-10 lg:grid-cols-[minmax(0,68ch)_15rem] lg:justify-center' : 'wrap-narrow']}>
      <div class="prose-md prose-recap" set:html={renderMarkdown(data.body)} />
      {
        toc.length >= 3 && (
          <nav class="hidden lg:block" aria-label="On this page">
            <div class="sticky top-24">
              <p class="eyebrow mb-3">On this page</p>
              <ol class="grid gap-1 border-l border-border">
                {toc.map((h) => (
                  <li><a href={`#${h.id}`} class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-meta text-muted-foreground no-underline hover:border-primary hover:text-foreground">{h.text}</a></li>
                ))}
              </ol>
            </div>
          </nav>
        )
      }
    </div>
    <div class="wrap-narrow flex flex-wrap items-center gap-3 border-t border-border py-6" data-share>
      <p class="font-semibold">Share this post</p>
      <a class="inline-flex min-h-11 items-center gap-2 rounded-md border border-input px-4 font-semibold no-underline hover:bg-muted" href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} rel="noopener noreferrer" target="_blank"><Icon name="brand-linkedin" size={18} />LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a>
      <a class="inline-flex min-h-11 items-center gap-2 rounded-md border border-input px-4 font-semibold no-underline hover:bg-muted" href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`} rel="noopener noreferrer" target="_blank"><Icon name="brand-x" size={18} />X<span class="visually-hidden"> (opens in a new tab)</span></a>
      <button type="button" class="hidden min-h-11 items-center gap-2 rounded-md border border-input px-4 font-semibold hover:bg-muted" data-copy-link={url}><Icon name="link" size={18} /><span data-copy-label>Copy link</span></button>
    </div>
  </article>

  {
    (newer || older) && (
      <nav class="wrap-narrow grid grid-cols-1 gap-4 pb-10 sm:grid-cols-2" aria-label="More posts">
        {older ? (
          <a href={`/blog/${older.id}/`} class="card card-hover group flex min-w-0 items-center gap-4 p-5 no-underline">
            <Icon name="arrow-left" size={22} />
            <span class="min-w-0"><span class="block text-sm font-bold text-muted-foreground">Older post</span><span class="block truncate font-display text-xl font-bold">{older.data.title}</span></span>
          </a>
        ) : <span />}
        {newer && (
          <a href={`/blog/${newer.id}/`} class="card card-hover group flex min-w-0 items-center justify-between gap-4 p-5 text-right no-underline">
            <span class="min-w-0"><span class="block text-sm font-bold text-muted-foreground">Newer post</span><span class="block truncate font-display text-xl font-bold">{newer.data.title}</span></span>
            <Icon name="arrow-right" size={22} />
          </a>
        )}
      </nav>
    )
  }

  {
    more.length > 0 && (
      <section class="wrap section-tight" aria-labelledby="more-posts">
        <h2 id="more-posts" class="mb-6">More from the blog</h2>
        <ul class="grid gap-6 md:grid-cols-3">
          {more.map((m) => (
            <li class="card card-hover card-lift relative flex flex-col gap-2 p-6">
              {m.data.tags[0] && <p class="eyebrow">{m.data.tags[0]}</p>}
              <h3><a href={`/blog/${m.id}/`} class="no-underline after:absolute after:inset-0 hover:underline">{m.data.title}</a></h3>
              <p class="line-clamp-3 text-muted-foreground">{m.data.description}</p>
              <p class="mt-auto pt-2 text-meta text-muted-foreground"><time datetime={m.data.pubDate}>{formatDateShort(m.data.pubDate)}</time> · {readingTime(m.data.body)} min read</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    related && (
      <section class="wrap-narrow pb-6" aria-labelledby="related">
        <h2 id="related" class="mb-5">About this event</h2>
        <EventCard event={related} speakers={speakers} feature />
      </section>
    )
  }
</BaseLayout>
