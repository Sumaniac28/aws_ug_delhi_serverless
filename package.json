{
  "name": "awsug-delhi-ncr-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/csp-hashes.mjs && node scripts/seo-check.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "test:seo": "node --test scripts/seo-check.test.mjs",
    "brand:badge": "node scripts/brand/extract-badge.mjs",
    "test:motion": "node --test scripts/motion.test.mjs",
    "migrate": "node scripts/migrate/run.mjs",
    "migrate:status": "node scripts/migrate/run.mjs --status",
    "migrate:upload": "node scripts/migrate/upload.mjs",
    "test:migrate": "node --test scripts/migrate/migrate.test.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "design:contrast": "node scripts/check-contrast.mjs",
    "design:lint": "npx -y -p @google/design.md designmd lint DESIGN.md",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/anek-latin": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/anek-latin": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@starwind-ui/astro": "^1.3.0",
    "@tabler/icons": "^3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "6.4.8",
    "markdown-it": "^14.1.0",
    "satori": "^0.63.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/markdown-it": "^14.1.2",
    "node-html-parser": "^9.0.5",
    "typescript": "^5.6.0",
    "vite": "7.3.7"
  }
}
