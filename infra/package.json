    "aws-cdk-lib": "2.274.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.1146.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  }
